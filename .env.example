# Copy to .env (git-ignored) and adjust. Never commit real secrets.

# ---- Postgres (infra/docker-compose.yml) ----
POSTGRES_USER=patribot
POSTGRES_PASSWORD=change-me
POSTGRES_DB=patribot
POSTGRES_PORT=5432

# ---- Data platform (pipelines/definitions.py) ----
# Checkout of the private patribot-data repo (bronze), or samples/bronze for synthetic data
PATRIBOT_DATA_DIR=data
# DuckDB warehouse + Parquet silver input (git-ignored)
PATRIBOT_WAREHOUSE_DIR=warehouse
# Reverse ETL target; leave empty to skip the Postgres copy
PATRIBOT_PG_DSN=postgresql://patribot:change-me@localhost:5432/patribot
# Warn when the newest collected run is older than this
PATRIBOT_FRESHNESS_HOURS=36
# Persist Dagster run history between `dagster dev` sessions (optional)
# DAGSTER_HOME=/absolute/path/to/.dagster_home

# ---- Collector (Phase 0) ----
RAIL_API_KEY=
