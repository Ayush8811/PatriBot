# Copy to .env.local for local runs. On Vercel set these in Project → Settings → Environment Variables instead.
# NEXT_PUBLIC_* values are inlined into the browser bundle at build time: they are public, never put secrets in them.
# Everything else below is server-only.

# ---------------------------------------------------------------- sign-in (single owner account)
# Username for the one account.
PATRIBOT_AUTH_USER=
# scrypt hash of the password: run `npm run hash-password` and paste the line it prints.
# Format: scrypt$N$r$p$saltB64$hashB64. In .env files Next.js expands "$VAR", so escape EVERY "$" as "\$"
# (the script prints the escaped form too). On Vercel paste the plain line.
PATRIBOT_AUTH_PASSWORD_HASH=
# Signs the session cookie (≥ 32 chars). Generate: openssl rand -base64 48
# Changing it signs everyone out.
PATRIBOT_SESSION_SECRET=
# Local development / tests only: 1 skips sign-in. Honoured ONLY with NEXT_PUBLIC_API_MOCK=1 or `next dev`;
# ignored in a real production build (where missing auth vars lock the app instead).
# PATRIBOT_AUTH_DISABLED=1

# ---------------------------------------------------------------- backend (FastAPI), used by the /api/proxy route
# Base URL of the API host, without /api/v1 (e.g. https://patribot-api.onrender.com). Never exposed to the browser.
PATRIBOT_API_URL=http://localhost:8000
# Shared key sent as the x-patribot-key header; must equal PATRIBOT_API_KEY on the API side.
PATRIBOT_API_KEY=

# ---------------------------------------------------------------- public build-time flags
# 1 = serve every API call from local fixtures (no backend needed). Must be UNSET on Vercel.
NEXT_PUBLIC_API_MOCK=0
# Optional, local dev only: call an API directly from the browser instead of the /api/proxy route
# (e.g. http://localhost:8000/api/v1 with a local API that has no key). Leave unset in deployments.
# NEXT_PUBLIC_API_BASE_URL=
# FR-26: ad slots, off during the POC
NEXT_PUBLIC_ADS_ENABLED=0
