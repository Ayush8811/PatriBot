# Copy to .env.local. NEXT_PUBLIC_* values are inlined at build time (public, never secrets).
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1
# 1 = serve every API call from local fixtures (no backend needed)
NEXT_PUBLIC_API_MOCK=0
# FR-26: ad slots, off during the POC
NEXT_PUBLIC_ADS_ENABLED=0
# Auth.js (Google) comes later; see lib/auth/index.ts. Server-only secrets go in .env.local, never in git:
# AUTH_SECRET=
# AUTH_GOOGLE_ID=
# AUTH_GOOGLE_SECRET=
